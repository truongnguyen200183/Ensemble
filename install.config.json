{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": {
    "name": "Ensemble Collab",
    "version": "1.0.0",
    "description": "Multi-agent autonomous collaboration engine with Real-time Web Dashboard",
    "repository": "https://github.com/truongnguyen200183/Ensemble.git",
    "branch": "main"
  },
  "server": {
    "host": "0.0.0.0",
    "port": 23000,
    "domain": "",
    "url": "http://localhost:23000",
    "cors_origins": "http://localhost:23000,http://127.0.0.1:23000",
    "auto_open_browser": true,
    "service_name": "ensemble"
  },
  "ollama": {
    "enabled": false,
    "prompt_during_install": true,
    "api_base": "http://192.168.86.23:11434",
    "model": "gemma4:12b",
    "description": "Tùy chọn kết nối mô hình cục bộ Ollama qua Aider CLI (hỏi khi cài đặt)"
  },
  "models": {
    "roles": {
      "lead": "gemini-3.8-flash-thinking",
      "worker": "gemini-3.8-flash",
      "reviewer": "gemini-3.8-flash-thinking"
    },
    "fallbacks": {
      "lead": [
        "gemini-3.8-flash-thinking",
        "gemini-3.8-flash",
        "gemini-4-argon",
        "claude-opus-5.5",
        "claude-sonnet-5.5"
      ],
      "worker": [
        "gemini-3.8-flash",
        "gemini-3.8-flash-thinking",
        "claude-sonnet-5.5"
      ],
      "reviewer": [
        "gemini-3.8-flash-thinking",
        "gemini-3.8-flash",
        "claude-opus-5.5"
      ]
    },
    "catalog": [
      {
        "id": "gemini-3.8-flash-thinking",
        "name": "Gemini 3.8 Flash (Thinking)",
        "badge": "Recommended",
        "description": "Suy nghĩ sâu, quota dồi dào, cân bằng tốc độ và chất lượng cho Lead / Reviewer",
        "category": "gemini",
        "tier": 1
      },
      {
        "id": "gemini-3.8-flash",
        "name": "Gemini 3.8 Flash",
        "badge": "Fast",
        "description": "Tốc độ phản hồi cực nhanh, tối ưu chi phí và không lo hết quota cho Worker",
        "category": "gemini",
        "tier": 2
      },
      {
        "id": "gemini-4-neon",
        "name": "Gemini 4 Neon",
        "badge": "New / High Speed",
        "description": "Thế hệ Gemini 4 mới với tốc độ vượt trội, tư duy sắc bén cho lập trình và tác tử",
        "category": "gemini",
        "tier": 2
      },
      {
        "id": "gemini-pro-orchestrator-neon",
        "name": "Orchestrator (Neon)",
        "badge": "New / Ultra Fast",
        "description": "Mô hình chuyên dụng tối ưu cho tác vụ điều phối nhóm tác tử tốc độ cao",
        "category": "gemini",
        "tier": 2
      },
      {
        "id": "gemini-4-argon",
        "name": "Gemini 4 Argon",
        "badge": "Heavy / Quota Sensitive",
        "description": "Mô hình suy luận mạnh nhất của Google nhưng giới hạn quota khắt khe",
        "category": "gemini",
        "tier": 3
      },
      {
        "id": "gemini-4-hydrogen",
        "name": "Gemini 4 Hydrogen",
        "badge": "New",
        "description": "Thế hệ mô hình mới cân bằng hiệu năng vượt trội và tư duy nâng cao",
        "category": "gemini",
        "tier": 3
      },
      {
        "id": "gemini-pro-orchestrator-g1-pro",
        "name": "Orchestrator (Argon)",
        "badge": "New",
        "description": "Mô hình chuyên dụng tối ưu cho tác vụ điều phối nhóm tác tử tự động",
        "category": "gemini",
        "tier": 3
      },
      {
        "id": "claude-opus-5.5",
        "name": "Claude Opus 5.5",
        "badge": "New",
        "description": "Khả năng phân tích kiến trúc hệ thống và phản biện chi tiết",
        "category": "claude",
        "tier": 4
      },
      {
        "id": "claude-sonnet-5.5",
        "name": "Claude Sonnet 5.5",
        "badge": "New",
        "description": "Tối ưu cho lập trình, tạo diff chính xác và phản hồi nhanh",
        "category": "claude",
        "tier": 5
      },
      {
        "id": "gpt-oss-120b",
        "name": "GPT-OSS 120B",
        "badge": "Notice",
        "description": "Mô hình mã nguồn mở cộng đồng",
        "category": "openai",
        "tier": 6
      },
      {
        "id": "ollama-gemma",
        "name": "Ollama Gemma 4 (12B Local)",
        "badge": "Local Network",
        "description": "Mô hình cục bộ chạy trên server Ollama nội bộ 192.168.86.23 (Không tốn quota)",
        "category": "ollama",
        "tier": 7
      }
    ]
  },
  "environment": {
    "ENSEMBLE_PORT": "23000",
    "ENSEMBLE_URL": "http://localhost:23000",
    "COLLAB_MONITOR": "none",
    "DEFAULT_LEAD_MODEL": "gemini-3.8-flash-thinking",
    "DEFAULT_WORKER_MODEL": "gemini-3.8-flash",
    "DEFAULT_REVIEWER_MODEL": "gemini-3.8-flash-thinking",
    "NODE_ENV": "production"
  },
  "platforms": {
    "windows": {
      "requires_wsl": true,
      "recommended_distro": "Ubuntu",
      "wsl_target_dir": "$HOME/ensemble",
      "cli_command": "collab",
      "required_wsl_packages": [
        "git",
        "curl",
        "tmux",
        "jq",
        "nodejs",
        "npm"
      ]
    },
    "macos": {
      "requires_wsl": false,
      "target_dir": "$HOME/Ensemble",
      "cli_command": "collab",
      "required_brew_packages": [
        "git",
        "curl",
        "tmux",
        "jq",
        "node"
      ]
    },
    "linux": {
      "requires_wsl": false,
      "target_dir": "$HOME/ensemble",
      "cli_command": "collab",
      "required_apt_packages": [
        "git",
        "curl",
        "tmux",
        "jq",
        "nodejs",
        "npm"
      ]
    }
  }
}

